{% comment %}
  Cool Story — blog teaser. Two most recent posts from "the-cool-story".
  Editorial card style with long-shadow hover.
{% endcomment %}

{% assign blog = blogs[section.settings.blog_handle] %}

<div class="color-{{ section.settings.color_scheme }} cs-blogteaser">
  <div class="cs-blogteaser__inner">
    <p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="cs-blogteaser__heading">{{ section.settings.heading }}</h2>
    <div class="cs-blogteaser__grid">
      {% for article in blog.articles limit: section.settings.post_count %}
        <a class="cs-card cs-blogteaser__card" href="{{ article.url }}">
          {% if article.image %}
            <div class="cs-blogteaser__media">
              {{ article.image | image_url: width: 720 | image_tag: alt: article.image.alt | default: article.title, loading: 'lazy', class: 'cs-blogteaser__img' }}
            </div>
          {% endif %}
          <div class="cs-blogteaser__body">
            <span class="cs-blogteaser__date cs-eyebrow">{{ article.published_at | date: '%b %d, %Y' }}</span>
            <span class="cs-blogteaser__title">{{ article.title }}</span>
            <span class="cs-blogteaser__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</span>
          </div>
        </a>
      {% else %}
        <p>No posts yet — the first story is coming. &lt;3</p>
      {% endfor %}
    </div>
    <a class="cs-blogteaser__all" href="{{ blog.url | default: '/blogs/the-cool-story' }}">Read all posts →</a>
  </div>
</div>

{% stylesheet %}
.cs-blogteaser { background: #E0E8C8; padding: clamp(2rem, 5vw, 4rem) 1.5rem; }
.cs-blogteaser__inner { max-width: 70rem; margin: 0 auto; }
.cs-blogteaser__heading {
  font-family: var(--font-display, sans-serif);
  font-weight: 400;
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  text-transform: uppercase;
  color: #000000;
  margin: 0.25rem 0 1.5rem;
}
.cs-blogteaser__grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
.cs-blogteaser__card { display: flex; flex-direction: column; text-decoration: none; }
.cs-blogteaser__media { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid #000000; }
.cs-blogteaser__img { width: 100%; height: 100%; object-fit: cover; }
.cs-blogteaser__body { display: grid; gap: 0.5rem; padding: 1.1rem; }
.cs-blogteaser__date { color: #482880; }
.cs-blogteaser__title { color: #000000; font-weight: 600; font-size: 1.125rem; line-height: 1.3; }
.cs-blogteaser__excerpt { color: #000000; font-size: 0.9375rem; line-height: 1.45; }
.cs-blogteaser__all {
  display: inline-block; margin-top: 1.5rem;
  color: #000000; font-family: var(--font-label, sans-serif);
  font-size: 0.875rem; letter-spacing: 0.1em; text-transform: uppercase;
}
.cs-blogteaser__all:hover { color: #5810E8; }
{% endstylesheet %}

{% schema %}
{
  "name": "CS Blog Teaser",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the shop journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Cool Story" },
    { "type": "text", "id": "blog_handle", "label": "Blog handle", "default": "the-cool-story" },
    { "type": "range", "id": "post_count", "label": "Posts", "min": 1, "max": 3, "step": 1, "default": 2 }
  ],
  "presets": [{ "name": "CS Blog Teaser" }]
}
{% endschema %}
